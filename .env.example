# Optional installer overrides. The app works without an .env file.
# Users upload VPN profiles and select folders through the web interface.
WEB_PORT=8080
WEB_BIND_IP=0.0.0.0
SECURE_COOKIES=false
DOWNLOADS_DIR=./downloads
# Non-root download identity. Must match in all three services.
PUID=1000
PGID=1000
TZ=Europe/Paris
# Gateway external DNS upstreams, reachable before and after VPN connection.
# Docker's internal DNS still resolves the private Compose service names.
VPN_DNS_PRIMARY=1.1.1.1
VPN_DNS_SECONDARY=9.9.9.9
# Memory ceilings, not measured consumption. Adjust to available NAS memory.
GATEWAY_MEMORY_LIMIT=128m
TRANSMISSION_MEMORY_LIMIT=192m
WEB_MEMORY_LIMIT=64m
